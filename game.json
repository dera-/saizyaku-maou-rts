{
  "width": 1280,
  "height": 720,
  "fps": 30,
  "main": "./script/_bootstrap.js",
  "assets": {
    "_bootstrap": {
      "type": "script",
      "path": "script/_bootstrap.js",
      "global": true
    },
    "main": {
      "type": "script",
      "path": "script/main.js",
      "global": true
    },
    "gameLogic": {
      "type": "script",
      "path": "script/gameLogic.js",
      "global": true
    },
    "sprites": {
      "type": "image",
      "path": "assets/sprites.png",
      "width": 1536,
      "height": 1024
    },
    "field": {
      "type": "image",
      "path": "assets/field-game.png",
      "width": 1280,
      "height": 720
    }
  },
  "environment": {
    "sandbox-runtime": "3",
    "nicolive": {
      "supportedModes": ["ranking"],
      "preferredSessionParameters": {
        "totalTimeLimit": 195
      }
    }
  }
}
